# ══ Square Credentials ══════════════════════════════════════
# Obtén esto en: developer.squareup.com → Tu app → Credentials
SQUARE_ACCESS_TOKEN=EAAAl_PEGA_TU_TOKEN_AQUI

# "production" para tu cuenta real, "sandbox" para el Sandbox de Square
SQUARE_ENV=sandbox

# ══ Square Location IDs ═════════════════════════════════════
# Para pruebas con UNA sola cuenta: pon el mismo ID en las tres variables
# Obtén el Location ID en: developer.squareup.com → Sandbox → Locations
LOC_NORTHMIAMI=L_PEGA_TU_LOCATION_ID
LOC_DORAL=L_PEGA_TU_LOCATION_ID
LOC_DOWNTOWN=L_PEGA_TU_LOCATION_ID

# ══ Servidor ════════════════════════════════════════════════
# Railway asigna este valor automáticamente
PORT=3000
