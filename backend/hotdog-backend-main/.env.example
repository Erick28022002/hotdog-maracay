# Cuenta demo/legado (webhook POS + /health). No se usa para pedidos web reales.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=production
SQUARE_WEBHOOK_KEY=

# Checkout web multi-sede — cada sede con su propia cuenta Square.
# Una sede sin estas dos variables queda deshabilitada para pedidos online
# (nunca cae en otra sede).
SQUARE_NMB_ACCESS_TOKEN=
SQUARE_NMB_LOCATION_ID=
SQUARE_DORAL_ACCESS_TOKEN=
SQUARE_DORAL_LOCATION_ID=
SQUARE_DOWNTOWN_ACCESS_TOKEN=
SQUARE_DOWNTOWN_LOCATION_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correos de confirmacion de pedidos pagados.
# Opcion recomendada si usas Microsoft 365 / Outlook.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=Miami@hotdogmaracay.com
SMTP_PASS=
ORDER_CONFIRMATION_FROM=Hot Dog Maracay Miami <Miami@hotdogmaracay.com>
ORDER_FROM_NMB=Hot Dog Maracay North Miami <Miami@hotdogmaracay.com>
ORDER_FROM_DORAL=Hot Dog Maracay Doral <Doral@hotdogmaracay.com>
ORDER_FROM_DOWNTOWN=Hot Dog Maracay Downtown <Downtown@hotdogmaracay.com>
ORDER_NOTIFICATION_EMAIL=Miami@hotdogmaracay.com

# Alternativa opcional con Resend.
RESEND_API_KEY=
