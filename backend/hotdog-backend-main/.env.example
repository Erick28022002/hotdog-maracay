SQUARE_NMB_LOCATION_ID=
SQUARE_DORAL_ACCESS_TOKEN=
SQUARE_DORAL_LOCATION_ID=
SQUARE_DOWNTOWN_ACCESS_TOKEN=
SQUARE_DOWNTOWN_LOCATION_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
