# Cuenta demo/legado (webhook POS + /health). No se usa para pedidos web reales.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=production
SQUARE_WEBHOOK_KEY=

# Checkout web multi-sede — cada sede con su propia cuenta Square.
