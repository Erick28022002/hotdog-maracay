# Cuenta demo/legado (webhook POS + /health). No se usa para pedidos web reales.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=production
SQUARE_WEBHOOK_KEY=

# Checkout web multi-sede — cada sede con su propia cuenta Square.
# Una sede sin estas dos variables queda deshabilitada para pedidos online
# (nunca cae en otra sede).
SQUARE_NMB_ACCESS_TOKEN=
SQUARE_NMB_LOCATION_ID=
SQUARE_DORAL_ACCESS_TOKEN=
SQUARE_DORAL_LOCATION_ID=
SQUARE_DOWNTOWN_ACCESS_TOKEN=
SQUARE_DOWNTOWN_LOCATION_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correos de confirmacion de pedidos pagados.
# Requiere una cuenta de Resend y un dominio/remitente verificado.
RESEND_API_KEY=
ORDER_CONFIRMATION_FROM=Hot Dog Maracay <orders@hotdogmaracay.com>
ORDER_NOTIFICATION_EMAIL=
